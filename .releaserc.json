{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "scripts/package-macos.sh --check",
        "prepareCmd": "scripts/package-macos.sh ${nextRelease.version}",
        "successCmd": "case ${nextRelease.version} in 0.*) gh release edit ${nextRelease.gitTag} --prerelease ;; esac"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["crates/app/Cargo.toml", "crates/app/macos/Info.plist", "Cargo.lock"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "target/dist/backfill-macos.zip", "label": "backfill for macOS (Apple silicon)" }],
        "releaseNameTemplate": "backfill <%= nextRelease.version %><%= nextRelease.version.startsWith('0.') ? ' beta' : '' %>",
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
