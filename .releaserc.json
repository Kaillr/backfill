{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/github",
      {
        "releaseNameTemplate": "backfill <%= nextRelease.version %><%= nextRelease.version.startsWith('0.') ? ' beta' : '' %>",
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "scripts/package-macos.sh --check",
        "prepareCmd": "scripts/package-macos.sh ${nextRelease.version}",
        "publishCmd": "scripts/upload-macos.sh ${nextRelease.gitTag}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["crates/app/Cargo.toml", "crates/app/macos/Info.plist", "Cargo.lock"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ]
  ]
}
